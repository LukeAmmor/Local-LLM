# Copy this file to .env and change what you need. Every variable is optional:
# the defaults live in backend/app/config.py. Never commit .env.

# --- Embedding model ---
RAG_EMBED_MODEL=BAAI/bge-m3
RAG_EMBED_DEVICE=cpu           # cuda | cpu (cpu at question time: see docs/vram-budget.md)
RAG_EMBED_FP16=true
RAG_EMBED_BATCH_SIZE=16
RAG_EMBED_MAX_LENGTH=1024
RAG_INGEST_EMBED_DEVICE=cuda   # device used by `python -m app.ingest`

# --- Chunking ---
RAG_CHUNK_SIZE_TOKENS=400
RAG_CHUNK_OVERLAP_RATIO=0.15
RAG_CHUNK_ADD_HEADER=true

# --- Languages (JSON list) ---
RAG_SUPPORTED_LANGUAGES=["en","fr"]

# --- Retrieval ---
RAG_RETRIEVAL_MODE=hybrid      # dense | sparse | hybrid
RAG_RETRIEVAL_TOP_K=30         # candidates kept by the search
RAG_RRF_K=60
RAG_CONTEXT_PASSAGES=5         # passages given to the LLM
RAG_PUBLIC_GROUP=public        # group every user may read

# --- Reranker ---
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_DEVICE=cuda         # cuda | cpu
RAG_RERANK_FP16=true
RAG_RERANK_BATCH_SIZE=32
RAG_RERANK_MAX_LENGTH=1024

# --- LLM (Ollama) ---
# Use 127.0.0.1, not localhost (on Windows, localhost tries IPv6 first: +2 s per connection).
# From inside a Docker container use http://host.docker.internal:11434
RAG_OLLAMA_URL=http://127.0.0.1:11434
RAG_LLM_MODEL=qwen3:8b
RAG_LLM_NUM_CTX=4096
RAG_LLM_KEEP_ALIVE=10m
RAG_LLM_NUM_PREDICT=768        # maximum answer length in tokens
RAG_LLM_TEMPERATURE=0.0
RAG_LLM_TIMEOUT_S=300

# --- Qdrant ---
RAG_QDRANT_URL=http://127.0.0.1:6333
RAG_QDRANT_COLLECTION=kb
